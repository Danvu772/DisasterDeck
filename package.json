{
  "name": "disaster-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait mongo",
    "db:check": "tsx --env-file=.env.local lib/db-check.ts",
    "db:seed": "tsx --env-file=.env.local lib/seed.ts",
    "api:check": "tsx --env-file=.env.local lib/api-check.ts",
    "check:tokens": "! grep -rnE \"#[0-9a-fA-F]{3,8}\\b|(bg|text|border|fill|stroke|ring|from|to)-(red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone|black|white)\\b|font-(serif|mono)\\b\" app components --include=*.ts --include=*.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "leaflet": "^1.9.4",
    "mongodb": "^6.22.0",
    "next": "15.5.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
