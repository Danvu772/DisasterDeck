{
  "name": "disaster-deck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "tsx --env-file=.env.local src/lib/db-check.ts",
    "db:reset": "tsx --env-file=.env.local src/lib/reset.ts",
    "load:check": "tsx --env-file=.env.local src/lib/load-check.ts",
    "db:seed": "tsx --env-file=.env.local src/lib/seed.ts",
    "db:people": "tsx --env-file=.env.local scripts/add-people.ts",
    "api:check": "tsx --env-file=.env.local src/lib/api-check.ts",
    "handlers:check": "tsx --env-file=.env.local src/lib/handlers-check.ts",
    "dispatch:check": "tsx --env-file=.env.local src/lib/dispatch-check.ts",
    "dispatch:backfill": "tsx --env-file=.env.local scripts/dispatch-backfill.ts",
    "keeper:check": "tsx --env-file=.env.local src/lib/keeper-check.ts",
    "helpdesk:check": "tsx --env-file=.env.local src/lib/helpdesk-check.ts",
    "sweeper:check": "tsx --env-file=.env.local src/lib/sweeper-check.ts",
    "reconcile:check": "tsx --env-file=.env.local src/lib/reconcile-check.ts",
    "health": "tsx --env-file=.env.local src/lib/health-report.ts",
    "top:check": "tsx --env-file=.env.local src/lib/top-check.ts",
    "gap:check": "tsx --env-file=.env.local src/lib/gap-check.ts",
    "security:check": "tsx --env-file=.env.local src/lib/security-check.ts",
    "brain": "tsx --env-file=.env.local src/workers/brain.ts",
    "check:name": "node scripts/check-name.mjs",
    "env:push": "bash deploy/vultr/push-env.sh",
    "check:tokens": "! grep -rnE \"#[0-9a-fA-F]{3,8}\\b|(bg|text|border|fill|stroke|ring|from|to)-(red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone|black|white)\\b|font-serif\\b\" src/app src/components --include=*.ts --include=*.tsx --include=*.css --exclude=globals.css --exclude-dir=api --exclude-dir=v2",
    "demo": "node scripts/dev-demo.mjs",
    "check:pilot": "node scripts/validate-demo-data.mjs && node scripts/check-antakya.mjs",
    "check:contacts": "node --import tsx --test scripts/contacts.test.mjs",
    "check:llm": "node --import tsx --test scripts/llm-adapter.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "1.32.1",
    "@trussworks/react-uswds": "13.0.1",
    "@uswds/uswds": "3.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "maplibre-gl": "^5.6.0",
    "mongodb": "^6.22.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-map-gl": "^8.1.3",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "sass": "^1.108.2",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  }
}
