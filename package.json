{
  "name": "disaster-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "tsx --env-file=.env.local lib/db-check.ts",
    "db:seed": "tsx --env-file=.env.local lib/seed.ts",
    "api:check": "tsx --env-file=.env.local lib/api-check.ts",
    "handlers:check": "tsx --env-file=.env.local lib/handlers-check.ts",
    "dispatch:check": "tsx --env-file=.env.local lib/dispatch-check.ts",
    "keeper:check": "tsx --env-file=.env.local lib/keeper-check.ts",
    "helpdesk:check": "tsx --env-file=.env.local lib/helpdesk-check.ts",
    "sweeper:check": "tsx --env-file=.env.local lib/sweeper-check.ts",
    "security:check": "tsx --env-file=.env.local lib/security-check.ts",
    "brain": "tsx --env-file=.env.local workers/brain.ts",
    "check:contract": "node docs/frontend/contract-check.mjs",
    "check:tokens": "! grep -rnE \"#[0-9a-fA-F]{3,8}\\b|(bg|text|border|fill|stroke|ring|from|to)-(red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone|black|white)\\b|font-serif\\b\" app components --include=*.ts --include=*.tsx --include=*.css --exclude=globals.css --exclude-dir=api --exclude-dir=v2",
    "demo": "node scripts/dev-demo.mjs",
    "check:pilot": "node scripts/validate-demo-data.mjs && node scripts/check-antakya.mjs",
    "replay:real": "node --env-file-if-exists=.env.local --import tsx workers/x-agent.ts --file data/replays/antakya-real-tweets.json --require-live",
    "replay:synthetic": "node --env-file-if-exists=.env.local --import tsx workers/x-agent.ts --file data/tweets_replay.json",
    "check:replay": "node --import tsx --test scripts/real-replay.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "leaflet": "^1.9.4",
    "mongodb": "^6.22.0",
    "next": "15.5.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
