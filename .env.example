# Copy to .env.local and fill in. Never commit .env.local.

# The team's MongoDB Atlas cluster: a mongodb+srv://... URI that Role 1 sends you privately.
# Left empty, the agents use fake data (fixtures) and the API routes cannot reach a database.
MONGODB_URI=
MONGODB_DB=disaster_desk

# Which disaster this desk is about.
DESK_ID=antakya-2023

# Shared secret for workers and any API client that posts events (x-agent-key header). Ask Role 1.
AGENT_KEY=

# 1 on our laptops: allows ?user=ID on the API instead of a real login.
DEMO_MODE=1

# The personal agents and Ask the desk (/api/chat) run on gpt-oss through OpenRouter (D-0003).
# Without this key every chat answers 502 "the agent failed this turn" (agents/shared/llm.ts reads it).
OPENROUTER_API_KEY=
# US in-region routing (Business plan): requests only reach provider endpoints in the US.
OPENROUTER_BASE_URL=https://us.openrouter.ai/api/v1
# Optional model and reasoning-effort overrides per purpose (chat, extract, summary, digest), e.g.:
# OPENROUTER_MODEL_CHAT=openai/gpt-oss-120b
# OPENROUTER_MODEL_DIGEST=openai/gpt-oss-20b
# OPENROUTER_EFFORT_SUMMARY=medium
# Voice (agents/shared/voice, D-0005): Amazon Transcribe + Polly are the default, reached through the
# task role's default credential chain (no keys here; on AWS the ECS task role supplies credentials).
# VOICE_PROVIDER=aws is the default; set elevenlabs for ElevenLabs for Government.
# VOICE_PROVIDER=
# aws endpoints (default us-east-1):
# AWS_REGION=
# AWS_TRANSCRIBE_BUCKET=            # S3 bucket for batch transcription of voice notes
# POLLY_VOICE_ID=                   # default per-language: Joanna (en), Mia (es)
# POLLY_ENGINE=neural
# ElevenLabs (only when VOICE_PROVIDER=elevenlabs):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NASA_API_KEY=

# SSOJet login (Role 3). From portal.ssojet.com > Applications > your app.
# Callback URL to register there: http://localhost:3000/api/auth/callback/ssojet (+ the tunnel URL).
SSOJET_CLIENT_ID=
SSOJET_CLIENT_SECRET=
# Your SSOJet project's own issuer: dashboard > Applications > your app > Advanced > Endpoints.
# The generic https://api.ssojet.com/ answers invalid_client for a project client id.
SSOJET_ISSUER_URL=https://<your-project>.auth.ssojet.com/
# Auth.js cookie secret: openssl rand -base64 32
AUTH_SECRET=
# Deployed server only (docs/agents/deploy.md): the public origin, so sign-in does not go to localhost.
# Leave unset on a laptop.
# AUTH_URL=https://disasterdeck.us
# Login email -> desk user id, until User has an email field. Unlisted emails become SSO_DEFAULT_USER.
SSO_USER_MAP=you@example.com=coordinator-duty
SSO_DEFAULT_USER=public-demo
