# Copy to .env.local and fill in. Never commit .env.local.

# The team's MongoDB Atlas cluster: a mongodb+srv://... URI that Role 1 sends you privately.
# Left empty, the agents use fake data (fixtures) and the API routes cannot reach a database.
MONGODB_URI=
MONGODB_DB=disaster_desk

# Which disaster this desk is about.
DESK_ID=antakya-2023

# Shared secret for workers and the scenario player (x-agent-key header). Ask Role 1.
AGENT_KEY=

# 1 on our laptops: allows ?user=ID on the API instead of a real login.
DEMO_MODE=1

# The personal agents and Ask the desk (/api/chat) run on Claude. Without this key every chat
# answers 502 "the agent failed this turn". Ask Role 2 (agents/shared/llm.ts reads it).
ANTHROPIC_API_KEY=
# Field voice: ElevenLabs speech-to-text for voice reports and spoken replies (agents/shared/voice.ts).
# Server-only: never use NEXT_PUBLIC_. Without it the field phone uses the browser's own speech.
ELEVENLABS_API_KEY=
# Optional voice ID. Defaults to the stock voice in agents/shared/voice.ts.
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
EXA_API_KEY=
NASA_API_KEY=

# Mapbox basemaps (components/map/basemap.tsx). A public token (pk.…) from account.mapbox.com,
# restricted to our URLs there. Empty: the Esri gray map. Optional: a Mapbox Studio style as
# "username/styleId", shown first as "Our style". Restart `npm run dev` after changing either.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=

# SSOJet login (Role 3). From portal.ssojet.com > Applications > your app.
# Callback URL to register there: http://localhost:3000/api/auth/callback/ssojet (+ the tunnel URL).
SSOJET_CLIENT_ID=
SSOJET_CLIENT_SECRET=
# Your SSOJet project's own issuer: dashboard > Applications > your app > Advanced > Endpoints.
# The generic https://api.ssojet.com/ answers invalid_client for a project client id.
SSOJET_ISSUER_URL=https://<your-project>.auth.ssojet.com/
# Auth.js cookie secret: openssl rand -base64 32
AUTH_SECRET=
# Login email -> desk user id, until User has an email field. Unlisted emails become SSO_DEFAULT_USER.
SSO_USER_MAP=you@example.com=coordinator-duty
SSO_DEFAULT_USER=public-demo
