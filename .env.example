# Copy to .env.local and fill in. Never commit .env.local.

# Local Docker MongoDB (npm run db:up). For Atlas, paste the mongodb+srv://... URI from Role 1.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=disaster_desk

# Which disaster this desk is about.
DESK_ID=malatya-2023

# Shared secret for workers and the scenario player (x-agent-key header). Ask Role 1.
AGENT_KEY=

# 1 on our laptops: allows ?user=ID on the API instead of a real login.
DEMO_MODE=1

OPENAI_API_KEY=
EXA_API_KEY=
NASA_API_KEY=
